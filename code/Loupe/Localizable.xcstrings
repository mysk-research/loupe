          "stringUnit" : {
            "state" : "translated",
            "value" : "Loupe tüm bunları tek bir yerde gösterir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loupe показує тобі все це в одному місці"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Loupe cho bạn thấy tất cả những điều đó ở một nơi"
