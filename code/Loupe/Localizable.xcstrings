    "write dates as \"%@\" instead of \"%@\"" : {
      "comment" : "Region-mismatch sub-clause about date formatting on the fingerprint summary sheet. First %@ is the user's locale-formatted sample date; second %@ is the regional baseline. Will be joined with other clauses by Oxford comma.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تكتب التواريخ كـ\"%@\" بدلًا من \"%@\""
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "schreibst Daten als \"%@\" statt als \"%@\""
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "write dates as \"%1$@\" instead of \"%2$@\""
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "escribes las fechas como \"%@\" en vez de \"%@\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "écrivez les dates « %@ » au lieu de « %@ »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "scrivi le date come «%1$@» invece di «%2$@»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付を「%2$@」ではなく「%1$@」と書いている"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜를 \"%2$@\" 대신 \"%1$@\" 형식으로 표기함"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "zapisujesz daty jako „%1$@” zamiast „%2$@”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "escreve datas como \"%@\" em vez de \"%@\""
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "escreve datas como «%@» em vez de «%@»"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "пишешь даты как «%@», а не «%@»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tarihleri \"%2$@\" yerine \"%1$@\" olarak yazıyorsun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "пишеш дати як «%@» замість «%@»"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "viết ngày tháng dưới dạng “%1$@” thay vì “%2$@”"
