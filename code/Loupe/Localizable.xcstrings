          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số giọng nói chuyển văn bản thành giọng nói khả dụng. Số lượng cao hơn thường có nghĩa là bạn đã tải về các giọng Nâng cao hoặc Cao cấp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
