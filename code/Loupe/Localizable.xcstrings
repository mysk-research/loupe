        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Độ chính xác Chính xác hoặc Giảm. Xác định mức độ chi tiết của tọa độ được báo cáo."
          }
        },
        "zh-Hans" : {
