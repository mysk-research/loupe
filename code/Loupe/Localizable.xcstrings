    "Voices you've explicitly downloaded. Most devices have none of these." : {
      "comment" : "Signal card rationale beneath the Enhanced / Premium voices value.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "الأصوات التي نزّلتها بنفسك. لا تحتوي معظم الأجهزة على أي منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stimmen, die du gezielt geladen hast. Auf den meisten Geräten gibt es davon keine."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voces que has descargado explícitamente. La mayoría de los dispositivos no tienen ninguna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voix que vous avez explicitement téléchargées. La plupart des appareils n'en ont aucune."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le voci che hai scaricato esplicitamente. La maggior parte dei dispositivi non ne ha nessuna."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "明示的にダウンロードした音声。ほとんどのデバイスにはこれらが入っていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 다운로드한 음성. 대부분의 기기에는 하나도 없어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Głosy, które samodzielnie pobrałeś. Większość urządzeń nie ma żadnego z nich."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vozes que você baixou explicitamente. A maioria dos dispositivos não tem nenhuma."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vozes que transferiu explicitamente. A maioria dos dispositivos não tem nenhuma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голоса, которые ты сам загрузил. На большинстве устройств их нет."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Açıkça indirdiğin sesler. Çoğu cihazda bunlardan hiçbiri yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голоси, які ти спеціально завантажив. На більшості пристроїв їх немає."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các giọng nói bạn đã tải xuống một cách rõ ràng. Hầu hết thiết bị không có giọng nói nào trong số này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你主动下载的语音。大多数设备一个都没有。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你主動下載的語音。大多數裝置上一個都沒有。"
          }
        }
      }
    },
