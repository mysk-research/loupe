          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il numero di contatti e le etichette che usi (Mamma, Coniuge, Lavoro) rivelano la tua cerchia sociale e le tue relazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連絡先の件数や使用しているラベル（母、配偶者、仕事など）から、交友関係や人間関係が見えてきます。"
