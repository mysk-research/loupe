    "Compact vs regular in each axis. Varies by device type and orientation." : {
      "comment" : "Signal card rationale beneath the Size class value.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مضغوط (Compact) مقابل عادي (Regular) في كل محور. يختلف حسب نوع الجهاز واتجاهه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompakt oder regulär je Achse. Variiert je nach Gerätetyp und Ausrichtung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compacto frente a regular en cada eje. Varía según el tipo de dispositivo y la orientación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compact ou regular sur chaque axe. Varie selon le type d'appareil et l'orientation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compatto o regolare su ciascun asse. Varia in base al tipo di dispositivo e all'orientamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各軸でのコンパクトかレギュラーかの値。デバイスの種類や向きによって変わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 축의 compact 대 regular 값. 기기 종류와 방향에 따라 달라져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kompaktowy lub zwykły w każdej osi. Różni się w zależności od typu urządzenia i orientacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compacto ou regular em cada eixo. Varia conforme o tipo do dispositivo e a orientação."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compacto ou normal em cada eixo. Varia consoante o tipo de dispositivo e a orientação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compact или regular по каждой оси. Зависит от типа устройства и ориентации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her eksende sıkışık ve normal karşılaştırması. Cihaz türüne ve yönüne göre değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Компактний чи звичайний по кожній осі. Залежить від типу пристрою та орієнтації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gọn so với thông thường trên mỗi trục. Thay đổi theo loại thiết bị và hướng màn hình."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
