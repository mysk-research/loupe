    "ISO country code from your App Store account. Pins the account to a country regardless of where the %@ is right now." : {
      "comment" : "Signal card rationale beneath the App Store country value. %@ is the device model name (e.g., iPhone, iPad).",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رمز الدولة ISO من حساب App Store الخاص بك. يربط الحساب بدولة بغضّ النظر عن مكان وجود الـ%@ الآن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ISO-Ländercode aus deinem App-Store-Account. Verankert das Konto in einem Land, unabhängig davon, wo sich das %@ gerade befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código de país ISO de tu cuenta de App Store. Asocia la cuenta a un país, sin importar dónde esté tu %@ ahora mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code pays ISO de votre compte App Store. Rattache le compte à un pays, peu importe où se trouve le %@ en ce moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codice paese ISO del tuo account App Store. Lega l'account a un paese indipendentemente da dove si trova ora il %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App StoreアカウントのISO国コード。お使いの%@が現在どこにあっても、アカウントは特定の国に紐づきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store 계정의 ISO 국가 코드. 지금 %@가 어디에 있든 계정을 특정 국가에 묶어 둬요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kod kraju ISO z Twojego konta App Store. Przypisuje konto do kraju niezależnie od tego, gdzie %@ jest w tej chwili."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código ISO do país da sua conta da App Store. Fixa a conta a um país independentemente de onde o %@ esteja agora."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Código de país ISO da sua conta da App Store. Associa a conta a um país, independentemente do local onde o %@ se encontra neste momento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код страны ISO из твоего аккаунта App Store. Привязывает аккаунт к стране независимо от того, где сейчас находится %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store hesabındaki ISO ülke kodu. %@ şu anda nerede olursa olsun, hesabı bir ülkeye sabitler."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Код країни ISO з твого облікового запису App Store. Прив'язує обліковий запис до країни незалежно від того, де зараз перебуває %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mã quốc gia ISO từ tài khoản App Store của bạn. Gắn tài khoản với một quốc gia bất kể %@ đang ở đâu lúc này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "来自你 App Store 账户的 ISO 国家或地区代码。无论你这台 %@ 当下身在何处，账户都会被锚定到这个国家或地区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的 App Store 帳號使用的 ISO 國家代碼。會把帳號固定到某個國家，與 %@ 目前所在位置無關。"
          }
        }
      }
    },
