    "use the %@ calendar instead of %@" : {
      "comment" : "Region-mismatch sub-clause about calendar systems on the fingerprint summary sheet. First %@ is the user's chosen calendar name; second %@ is the baseline calendar for their region. Will be joined with other clauses by Oxford comma.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تستخدم تقويم %@ بدلًا من %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "verwendest den %1$@-Kalender statt des %2$@-Kalenders"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "use the %1$@ calendar instead of %2$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "usas el calendario %@ en vez del calendario %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "utilisez le calendrier %@ au lieu du calendrier %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "usi il %1$@ invece del %2$@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ではなく%1$@カレンダーを使用している"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 대신 %1$@ 캘린더를 사용함"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "używasz kalendarza %1$@ zamiast %2$@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "usa o calendário %@ em vez de %@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "utiliza o calendário %@ em vez de %@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "пользуешься календарём %@, а не %@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ yerine %1$@ takvimini kullanıyorsun"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "користуєшся календарем %@ замість %@"
          }
        },
        "vi" : {
