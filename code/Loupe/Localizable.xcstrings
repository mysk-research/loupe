    "Gravity vector in g, separated from user-induced acceleration by the system." : {
      "comment" : "Signal card rationale beneath the Gravity value in the Device Motion category.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "متجه الجاذبية بـ g، مفصولًا عن التسارع الناتج عن المستخدم بواسطة النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schwerkraftvektor in g, vom System getrennt von der durch den Nutzer verursachten Beschleunigung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vector de gravedad en g, separado por el sistema de la aceleración inducida por el usuario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vecteur de gravité en g, isolé par le système de l'accélération induite par l'utilisateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vettore di gravità in g, separato dal sistema dall'accelerazione causata da te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムがユーザーによる加速と切り離した、g単位の重力ベクトル。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템이 사용자 가속과 분리한 g 단위의 중력 벡터."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wektor grawitacji w g, oddzielony przez system od przyspieszenia wywołanego przez użytkownika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetor de gravidade em g, separado pelo sistema da aceleração causada pelo usuário."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vetor de gravidade em g, separado pelo sistema da aceleração induzida pelo utilizador."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вектор гравитации в g, отделённый системой от ускорения, вызванного движением."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem tarafından kullanıcı kaynaklı ivmeden ayrılmış, g cinsinden yerçekimi vektörü."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вектор сили тяжіння в g, відокремлений системою від прискорення, спричиненого користувачем."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vectơ trọng lực tính bằng g, được hệ thống tách khỏi gia tốc do người dùng tạo ra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以 g 为单位的重力向量，由系统从用户施加的加速度中分离出来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由系統將重力向量（單位 g）與使用者造成的加速度分開後得出的數值。"
          }
        }
      }
    },
