    "Comparing your region's defaults with the settings you've customized." : {
      "comment" : "Caption beneath the region-mismatch narrative card on the fingerprint summary sheet — explains where the claim came from.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بمقارنة الإعدادات الافتراضية لمنطقتك مع الإعدادات التي خصصتها."
          }
        },
        "de" : {
          "stringUnit" : {
