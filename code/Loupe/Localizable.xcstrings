        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba wydarzeń, kalendarze, które synchronizujesz, oraz źródła za nimi (iCloud, Exchange, Google) odzwierciedlają Twój rytm dnia i usługi, z których korzystasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quantidade de eventos, os calendários que você sincroniza e as origens por trás deles (iCloud, Exchange, Google) refletem sua rotina e os serviços que você usa."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
