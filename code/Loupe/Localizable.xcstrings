        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deducido de una zona horaria (%@) que no coincide con el ajuste de región de tu %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déduit d'un fuseau horaire (%@) qui ne correspond pas au réglage de région de votre %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dedotto da un fuso orario (%1$@) che non corrisponde all'impostazione di regione del tuo %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの%2$@の地域設定と一致しないタイムゾーン（%1$@）から推測。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 %2$@의 지역 설정과 맞지 않는 시간대(%1$@)에서 추론함."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wywnioskowane ze strefy czasowej (%1$@), która nie pasuje do ustawienia regionu Twojego %2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inferido de um fuso horário (%@) que não combina com o ajuste de região do seu %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
