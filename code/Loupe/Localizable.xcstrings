    },
    "Your latitude and longitude. With Reduced accuracy, this is a general area rather than a precise point." : {
      "comment" : "Signal card rationale beneath the Coordinate value.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "خطوط الطول والعرض الخاصة بك. مع تقليل الدقة، تصبح هذه منطقة عامة بدلًا من نقطة دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Breiten- und Längengrad. Bei reduzierter Genauigkeit ist das eine grobe Region statt eines exakten Punkts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu latitud y longitud. Con Precisión reducida, es una zona general en lugar de un punto exacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre latitude et votre longitude. Avec la précision réduite, il s'agit d'une zone générale plutôt que d'un point précis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua latitudine e longitudine. Con la precisione ridotta, si tratta di un'area generica anziché di un punto preciso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緯度と経度。「正確な位置情報」がオフのときは、正確な地点ではなく、おおよそのエリアになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위도와 경도. 정확도를 낮추면 정밀한 지점이 아니라 대략적인 지역으로 표시돼요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja szerokość i długość geograficzna. Przy zmniejszonej dokładności jest to ogólny obszar, a nie dokładny punkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua latitude e longitude. Com Precisão Reduzida, isto é uma área geral, não um ponto preciso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua latitude e longitude. Com a precisão reduzida, corresponde a uma área geral em vez de um ponto exato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твои широта и долгота. При сниженной точности — это общая область, а не точная точка."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enlem ve boylamın. Azaltılmış doğrulukta, kesin bir nokta yerine genel bir alan gösterir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твої широта й довгота. У режимі зниженої точності це загальна зона, а не конкретна точка."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vĩ độ và kinh độ của bạn. Với độ chính xác Giảm, đây là một khu vực chung thay vì một điểm chính xác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的纬度和经度。在精度降低模式下，这只是一个大致区域，而不是精确位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的緯度和經度。啟用「降低精確度」時，這只是一個大略區域，而不是精確的點位。"
          }
        }
      }
    },
    "Your preferred first day of the week. May differ from your region's default." : {
      "comment" : "Signal card rationale beneath the First day of week value.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اليوم الأول المفضل لديك في الأسبوع. قد يختلف عن الإعداد الافتراضي لمنطقتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein bevorzugter erster Wochentag. Kann vom Standard deiner Region abweichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu primer día de la semana preferido. Puede no coincidir con el predeterminado de tu región."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le premier jour de la semaine que vous préférez. Peut différer de la valeur par défaut de votre région."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il primo giorno della settimana che preferisci. Può differire da quello predefinito della tua area geografica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "週の始まりとして設定している曜日。地域のデフォルトと異なる場合があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선호하는 한 주의 시작 요일. 지역 기본값과 다를 수 있어요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferowany przez Ciebie pierwszy dzień tygodnia. Może różnić się od domyślnego dla Twojego regionu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu primeiro dia da semana preferido. Pode ser diferente do padrão da sua região."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dia da semana com que prefere começar. Pode diferir da predefinição da sua região."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Какой день у тебя считается первым в неделе. Может отличаться от стандартного для региона."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tercih ettiğin haftanın ilk günü. Bölgenin varsayılanından farklı olabilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Твій бажаний перший день тижня. Може відрізнятися від типового для твого регіону."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngày đầu tuần ưa thích của bạn. Có thể khác với mặc định của khu vực bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你偏好的一周起始日。可能与你所在地区的默认设置不同。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你偏好的一週起始日，可能與你所在地區的預設值不同。"
          }
        }
      }
    },
    "Your preferred time format: 12-hour or 24-hour." : {
      "comment" : "Signal card rationale beneath the Hour cycle value.",
      "localizations" : {
        "ar" : {
