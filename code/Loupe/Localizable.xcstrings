          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precisão Exata ou Reduzida. Determina a granularidade das coordenadas reportadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точно или приблизительно. Определяет, насколько подробно сообщаются координаты."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
