    "Inset values shaped by the notch or Dynamic Island. Varies by device chassis." : {
      "comment" : "Signal card rationale beneath the safeAreaInsets value.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قيم الهوامش الداخلية التي يحددها النتوء (Notch) أو الجزيرة التفاعلية (Dynamic Island). تختلف حسب هيكل الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einrückungswerte, geprägt durch die Notch oder Dynamic Island. Variiert je nach Gehäuse."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de margen determinados por el notch o la Dynamic Island. Varían según el chasis del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valeurs d'encart définies par l'encoche ou le Dynamic Island. Varient selon le châssis de l'appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valori dei margini determinati dal notch o dalla Dynamic Island. Variano in base alla scocca del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノッチやDynamic Islandの形に合わせたインセットの値。デバイスの筐体によって異なります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "노치나 Dynamic Island 모양에 따라 정해지는 인셋 값. 기기 외형에 따라 달라져요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartości marginesów ukształtowane przez wcięcie lub Dynamic Island. Różnią się w zależności od obudowy urządzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de recuo definidos pelo entalhe ou pela Dynamic Island. Variam conforme o chassi do dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de margem definidos pelo entalhe ou pela Dynamic Island. Variam consoante o chassis do dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отступы зависят от выреза или Dynamic Island. У разных корпусов они разные."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çentik veya Dynamic Island tarafından şekillendirilen kenar boşlukları. Cihaz kasasına göre değişir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення відступів, які задає виріз або Dynamic Island. Залежить від корпусу пристрою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các giá trị lề được định hình bởi phần khuyết hoặc Dynamic Island. Thay đổi theo khung máy của thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由刘海或灵动岛决定的边距值。因机身设计而异。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由瀏海或動態島形成的內距值。會因機身設計而異。"
          }
        }
      }
    },
